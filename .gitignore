# Dependencies
node_modules/
.pnp
.pnp.js

# Compiler / bundler output
dist/
out/
*.tsbuildinfo

# Electron build artefacts
apps/desktop/dist/
apps/desktop/release/

# NOTE: `build/` is deliberately NOT ignored.
# It holds the mascot source (build/icon.svg) and the generated icons that
# electron-builder and the runtime window need. Ignoring it left fresh clones
# unable to package the app at all. Regenerate with `npm run icons`.

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Never commit credentials or local agent state.
# The broad *key*.txt pattern is intentional: it is far better to ignore an
# innocuous file than to publish a real API key.
testkey.txt
*key*.txt
*.key
*.pem
ghostbot-secrets.json
ghostbot-secrets.enc
ghostbot-settings.json
ghostbot-agents.json
ghostbot-transcript-*.json
client-persistence.json

# Debug screenshots at the repo root (GHOSTBOT_CAPTURE output)
/*.png
.panels-test.mjs
.history-test.mjs

# Bot tokens and similar credentials used for live verification.
*token*.txt
.routines-test.mjs
