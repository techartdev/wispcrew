{
  "name": "@wispcrew/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "WispCrew desktop app — Electron shell + chat UI.",
  "license": "MIT",
  "author": "WispCrew contributors",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=esm --outfile=dist/main.mjs --external:electron --external:@wispcrew/* --sourcemap",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@wispcrew/core": "0.1.0",
    "@wispcrew/llm": "0.1.0",
    "@wispcrew/mcp": "0.1.0",
    "@wispcrew/runtime": "0.1.0",
    "@wispcrew/shared": "0.1.0",
    "@wispcrew/tools": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
