# Copy to .env, or just set these in your shell.
# Used by the headless CLI example; the desktop app stores its key encrypted
# via Settings instead (see SECURITY.md).
#
# Never commit a real key. `.env` and `*key*.txt` are gitignored.

WISPCREW_PROVIDER=deepseek
WISPCREW_API_KEY=sk-...
WISPCREW_MODEL=deepseek-chat
# WISPCREW_BASE_URL=https://api.deepseek.com

# Local providers need no key at all:
# WISPCREW_PROVIDER=ollama
# WISPCREW_MODEL=llama3.2
